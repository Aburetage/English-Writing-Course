```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Build directories
dist/
build/
target/
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# Python specific
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# Java specific
*.class
*.jar
.gradle/

# System files
.DS_Store
Thumbs.db
```